{
  "name": "@edgestore/cli",
  "version": "1.0.0-next.3",
  "description": "Command-line interface for EdgeStore accounts and projects",
  "homepage": "https://edgestore.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgestorejs/edgestore.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Ravi <me@ravi.com>",
  "type": "module",
  "bin": {
    "edgestore": "dist/bin.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "cli",
    "upload",
    "file",
    "cdn",
    "edgestore",
    "edge-store"
  ],
  "scripts": {
    "build": "pnpm typecheck && rollup --config rollup.config.ts --configPlugin rollup-plugin-swc3",
    "dev": "pnpm build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --cache --report-unused-disable-directives src"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@edgestore/sdk": "1.0.0-next.3",
    "@manypkg/find-root": "3.1.0",
    "@manypkg/get-packages": "3.1.0",
    "@napi-rs/keyring": "1.3.0",
    "commander": "15.0.0",
    "env-paths": "4.0.0",
    "log-update": "8.0.0",
    "open": "11.0.0",
    "openid-client": "6.8.4",
    "package-manager-detector": "1.8.0",
    "picocolors": "1.1.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "typescript": "5.9.3"
  }
}
